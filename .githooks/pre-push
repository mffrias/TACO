#!/usr/bin/env bash
# Optional pre-push check. Enable it once per clone with:
#
#     git config core.hooksPath .githooks
#
# When the commits being pushed touch code (src/, lib/, tests/, unittest/,
# scripts/, build.xml), it runs `scripts/smoke-test.sh --quick`
# (about 40 seconds) on the working tree and aborts the push if a benchmark
# behaves differently. Pushes that only touch documentation are not checked.
# It never blocks when no usable JDK 8, Java 7 class library or MiniSat-capable
# dynalloy4 is set up, or tests/ has local changes; it warns and lets the push
# through. Skip it once with
# `git push --no-verify`.
set -eo pipefail

root="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
code_paths='^(src|lib|tests|unittest|scripts)/|^build\.xml$'

changed=""
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue    # deleting a remote branch
    if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        files="$(git diff --name-only "$remote_sha" "$local_sha")"
    else
        # New remote branch (or unknown remote state): commits not on any remote yet.
        files="$(git log --format= --name-only "$local_sha" --not --remotes)"
    fi
    changed="$changed$files"$'\n'
done

if ! printf '%s' "$changed" | grep -qE "$code_paths"; then
    exit 0
fi

cd "$root"
. scripts/common.sh
if ! (STRYKER_SOLVER=minisat; require_jdk; require_classlib; require_solver) > /dev/null 2>&1; then
    echo "pre-push: code changed but Stryker cannot run here (JDK 8, Java 7 class library or MiniSat-capable dynalloy4 missing); smoke test skipped." >&2
    echo "pre-push: run scripts/smoke-test.sh to see what is missing." >&2
    exit 0
fi
if [ -n "$(git status --porcelain -- tests)" ]; then
    echo "pre-push: tests/ has local changes; smoke test skipped. Run scripts/smoke-test.sh yourself." >&2
    exit 0
fi

echo "pre-push: code changed, running scripts/smoke-test.sh --quick (skip with git push --no-verify)" >&2
if ! scripts/smoke-test.sh --quick >&2; then
    echo "pre-push: push aborted because Stryker's behaviour changed (details in smoke-test.log)." >&2
    echo "pre-push: if the change is intended, update EXPECTED in scripts/smoke-test.sh." >&2
    exit 1
fi
